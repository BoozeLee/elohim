# generated gate output -- includes the instrument's own out/ directory
skills/*/out/
skills/*/instrument/out/
plugins/*/skills/*/out/
plugins/*/skills/*/instrument/out/
harness/out/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# build output -- `python3 -m build` writes the wheel and the sdist here, and
# both workflows read the directory rather than either file. The trailing slash
# is load-bearing: it matches a *directory* named dist at any depth and not
# `tests/fixtures/wheel_dist`, whose 0-byte wheels are committed fixtures.
dist/

# node
node_modules/

# scratch used by the test harness
_probe_scratch.py

# environment
.env
.env.*
!.env.example

# build artifacts
*.egg-info/
.mypy_cache/
ruff_cache/
